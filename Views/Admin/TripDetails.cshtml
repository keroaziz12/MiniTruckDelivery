@model MiniTruckDelivery.Models.AdminTripDetailsViewModel
@{ ViewData["Title"] = "Manage trip"; }
<div class="page-heading"><div><span class="eyebrow">ADMIN · TRIP #@Model.Id</span><h1>@Model.CustomerName</h1><p>@Model.StartLocation → @Model.EndLocation · @Model.TripDate.ToString("yyyy-MM-dd")</p></div><a asp-action="Trips" class="btn btn-outline-primary">Back to trips</a></div>
@if (TempData["AdminMessage"] is string message) { <div class="alert alert-info">@message</div> }
<section class="surface-card p-4 mb-4"><div class="row g-3"><div class="col-md-4"><strong>Driver</strong><div>@Model.DriverName</div></div><div class="col-md-4"><strong>Agreed amount</strong><div>@Model.AgreedAmount.ToString("N2")</div></div><div class="col-md-4"><strong>Status</strong><div>@(Model.IsCancelled ? "Cancelled" : "Active")</div></div><div class="col-md-4"><strong>Total expenses</strong><div>@Model.TotalExpenses.ToString("N2")</div></div><div class="col-md-4"><strong>Net income</strong><div>@((Model.AgreedAmount - Model.TotalExpenses).ToString("N2"))</div></div></div>
<div class="d-flex flex-wrap gap-2 mt-4">@if (Model.IsCancelled) { <form asp-action="RestoreTrip" asp-route-id="@Model.Id" method="post"><button class="btn btn-success" type="submit">Restore trip</button></form> } else { <form asp-action="CancelTrip" asp-route-id="@Model.Id" method="post"><button class="btn btn-warning" type="submit">Cancel trip</button></form> }
<form asp-action="DeleteTrip" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Permanently delete this trip and all its expenses? This cannot be undone.');"><button class="btn btn-danger" type="submit">Permanently delete</button></form></div></section>
<section class="surface-card table-card"><div class="p-4 pb-2"><h2 class="h4">Expense records</h2></div><div class="table-responsive"><table class="table align-middle app-table mb-0"><thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Amount</th></tr></thead><tbody>
@foreach (var expense in Model.Expenses) { <tr><td>@expense.ExpenseDate.ToString("yyyy-MM-dd")</td><td>@expense.ExpenseType</td><td>@expense.Description</td><td>@expense.Amount.ToString("N2")</td></tr> }
@if (!Model.Expenses.Any()) { <tr><td colspan="4" class="empty-row">No expenses recorded for this trip.</td></tr> }
</tbody></table></div></section>
