@model MiniTruckDelivery.Models.ViewModels.ComplaintViewModel
@{
    ViewData["Title"] = "Contact Support";
}
<div class="form-page support-page">
    <span class="eyebrow">DRIVER SUPPORT</span>
    <h1>Send a complaint</h1>
    <p class="text-muted">Tell us what happened. Your message will be sent privately to the administrator.</p>

    <form id="emailForm" class="surface-card form-card" method="post" action="#" onsubmit="return false;">
        <input type="hidden" name="name" value="@User.Identity?.Name" />
        <div class="mb-3">
            <label for="subject" class="form-label">Subject</label>
            <input id="subject" name="subject" class="form-control" required minlength="3" maxlength="100" placeholder="Briefly describe the issue" />
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Your email for a reply</label>
            <input id="email" name="email" class="form-control" type="email" required maxlength="254" autocomplete="email" placeholder="name@example.com" />
        </div>
        <div class="mb-3">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" class="form-control message-input" rows="6" required minlength="10" maxlength="2000" placeholder="Write your message (10–2000 characters)"></textarea>
        </div>
        <div id="emailFormStatus" class="email-form-status" role="status" aria-live="polite"></div>
        <button id="sendEmailButton" type="submit" class="btn btn-primary">Send message <span aria-hidden="true">↗</span></button>
        <a id="emailFallbackLink" class="email-fallback" href="mailto:kerilesaziz12@gmail.com" hidden>Open your email app to send this message</a>
    </form>
    <noscript><p class="mt-3">JavaScript is disabled. <a href="mailto:kerilesaziz12@gmail.com">Email support directly</a>.</p></noscript>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@5/dist/email.min.js"></script>
    <script src="~/js/complaint-email.js" asp-append-version="true"></script>
}
@functions {
    private object emailjs;
}
