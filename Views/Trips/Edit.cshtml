@model MiniTruckDelivery.Models.Trip

@{
    ViewData["Title"] = "Edit Trip";
}

<div class="form-page"><h1>Edit Trip</h1>

<form class="form-card" asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="All" class="text-danger"></div>


  

    <div class="mb-3">
        <label asp-for="CustomerName" class="form-label">Customer Name</label>
        <input asp-for="CustomerName" class="form-control" />
        <span asp-validation-for="CustomerName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartLocation" class="form-label">Starting Location</label>
        <input asp-for="StartLocation" class="form-control" />
        <span asp-validation-for="StartLocation" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndLocation" class="form-label">Destination</label>
        <input asp-for="EndLocation" class="form-control" />
        <span asp-validation-for="EndLocation" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AgreedAmount" class="form-label">Agreed Amount</label>
        <input asp-for="AgreedAmount"
               type="number"
               step="0.01"
               class="form-control" />
        <span asp-validation-for="AgreedAmount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TripDate" class="form-label">Trip Date</label>
        <input asp-for="TripDate" type="date" class="form-control" />
        <span asp-validation-for="TripDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Back to Trips</a>
</form>

</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

